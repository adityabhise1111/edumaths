generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @unique
  name      String
  username  String   @unique
  email     String   @unique
  profilePicture String?
  role      String?     // TEACHER or STUDENT
  createdAt DateTime @default(now())

  // Relations
  classes       Class[]        @relation("TeacherClasses") // if teacher → many classes
  classMembers  ClassMember[]  // if student → memberships
  scores        Score[]        // Add this relation for student scores
}

model Class {
  id          String   @unique
  name        String
  description String?
  profilePicture String?
  coverPicture   String?
  createdAt   DateTime      @default(now())

  teacher     User          @relation("TeacherClasses", fields: [teacherId], references: [id])
  teacherId   String

  members     ClassMember[]
  exams       Exam[]        // Add this relation for class exams
}

model ClassMember {
  id        String   @unique
  student   User     @relation(fields: [studentId], references: [id])
  studentId String

  class     Class    @relation(fields: [classId], references: [id])
  classId   String

  status    MemberStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  joinedAt  DateTime     @default(now())
}

enum Role {
  TEACHER
  STUDENT
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

model Question {
  id           String   @unique
  questionText String
  optionA      String
  optionB      String
  optionC      String
  optionD      String
  correctOption String   // e.g. "A", "B", "C", "D"
  level        String    // "easy" | "medium" | "hard"

  examQuestions ExamQuestion[]
}

// --------------------
// Exam table
// --------------------
model Exam {
  id          String   @unique
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  startTime   DateTime
  endTime     DateTime
  levelOfExam String   // "easy" | "medium" | "hard"

  examQuestions ExamQuestion[]
  scores        Score[]
}

// --------------------
// Linking Exam ↔ Questions
// --------------------
model ExamQuestion {
  id         String   @unique
  examId     String
  questionId String

  exam       Exam     @relation(fields: [examId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
}

// --------------------
// Student scores
// --------------------
model Score {
  id        String   @unique
  studentId String
  examId    String
  score     Int

  student   User @relation(fields: [studentId], references: [id])
  exam      Exam @relation(fields: [examId], references: [id])
}