generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @unique
  name      String
  username  String   @unique
  email     String   @unique
  profilePicture String?
  role      String?     // TEACHER or STUDENT
  createdAt DateTime @default(now())

  // Relations
  classes       Class[]        @relation("TeacherClasses") // if teacher → many classes
  classMembers  ClassMember[]  // if student → memberships
}

model Class {
  id          String   @unique
  name        String
  description String?
  profilePicture String?
  coverPicture   String?
  createdAt   DateTime      @default(now())

  teacher     User          @relation("TeacherClasses", fields: [teacherId], references: [id])
  teacherId   String

  members     ClassMember[]
}

model ClassMember {
  id        String   @unique
  student   User     @relation(fields: [studentId], references: [id])
  studentId String

  class     Class    @relation(fields: [classId], references: [id])
  classId   String

  status    MemberStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  joinedAt  DateTime     @default(now())
}

enum Role {
  TEACHER
  STUDENT
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
npx
}